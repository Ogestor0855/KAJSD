# Porta HTTP (a hospedagem normalmente define sozinha)
PORT=3000

# Segredo usado para assinar o webhook de pagamento (HMAC-SHA256).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele o webhook fica desativado e nenhum pedido vira "paid".
PAYMENT_WEBHOOK_SECRET=

# Caminho do PDF entregue após o pagamento (fora da pasta pública)
PRODUCT_PDF_PATH=private/gta-iv-clip-lucro.pdf

# Arquivo onde os pedidos são salvos
ORDERS_FILE=data/orders.json

# Link do checkout de cartão de crédito (InfinitePay). O botão "Cartão de crédito" redireciona para cá.
INFINITEPAY_CHECKOUT_URL=https://link.infinitepay.io/isaque085/VC1DLTAtUg-LXzP45g8Yz-27,50

# Admin (/admin). Sem estas variáveis vale o acesso padrão definido em server.js (senha guardada só como hash).
# Para trocar a senha: npm run hash-senha -- "nova senha"  e cole o resultado abaixo.
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# Em produção (HTTPS) o cookie de sessão do admin passa a ser Secure
NODE_ENV=production

# Período da oferta de R$ 27,50 (horário de Brasília). Fora dele o checkout não aceita novas compras.
OFFER_START=2026-11-19T00:00:00-03:00
OFFER_END=2026-11-26T23:59:59-03:00
