# Usado só pelo `npm run confirmar` (script local). O site em si lê variáveis/secrets do Cloudflare
# (wrangler.toml + `npx wrangler pages secret put ...`) e, em desenvolvimento, do arquivo .dev.vars.

# Mesmo valor do secret PAYMENT_WEBHOOK_SECRET do Cloudflare Pages.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# URL do site publicado (com ela o script lê o D1 remoto e chama o webhook em produção)
SITE_URL=https://gta6-7b7.pages.dev
